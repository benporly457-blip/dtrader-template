<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 80" width="100%" height="100%">
  <defs>
    <!-- Anthex Glowing Emerald Gradient -->
    <linearGradient id="anthex-emerald" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#34D399" />
      <stop offset="50%" stop-color="#10B981" />
      <stop offset="100%" stop-color="#059669" />
    </linearGradient>
    <!-- Outer Glow -->
    <filter id="emerald-glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Glowing Emerald Icon Frame -->
  <rect x="8" y="8" width="64" height="64" rx="18" fill="none" stroke="url(#anthex-emerald)" stroke-width="4" filter="url(#emerald-glow)" />

  <!-- Upward Trend Line & Arrow -->
  <path d="M 24 50 L 36 38 L 44 46 L 56 26 M 48 26 L 56 26 L 56 34" fill="none" stroke="url(#anthex-emerald)" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
</svg>
